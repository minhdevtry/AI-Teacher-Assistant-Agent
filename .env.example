# =============================================================
# ZaloAgent — Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Prisma) ---
# Transaction-mode pooler (pgBouncer) — used by Prisma CLI for migrations
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode direct connection — used by Mastra PostgresStore + seed
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Zalo Bot ---
ZALO_BOT_TOKEN=your-zalo-bot-token
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=

# --- AI Model (OpenAI-compatible) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o

# --- Redis (BullMQ) — OPTIONAL ---
# Set REDIS_ENABLED=true to enable BullMQ background jobs (requires a running Redis instance)
REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Google Sheets — OPTIONAL (leave empty to disable) ---
# GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY=
# GOOGLE_SHEETS_SHEET_ID=

# --- Node.js Memory ---
NODE_OPTIONS=--max-old-space-size=4096
